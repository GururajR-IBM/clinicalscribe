!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo

# ── Node / Frontend ───────────────────────────────────────────────────
node_modules/
.pnpm-store/
.pnpm-debug.log*
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
.eslintcache

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/

# ── Env / Secrets (NEVER commit) ──────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
**/local.settings.json

# ── Terraform ─────────────────────────────────────────────────────────
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfvars
!**/environments/*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ── Docker ────────────────────────────────────────────────────────────
*.tar
.dockerignore.bak

# ── Test outputs / coverage ───────────────────────────────────────────
coverage/
test-results/
playwright-report/
