  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "prettier": "^3.4.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\""
  }
}
