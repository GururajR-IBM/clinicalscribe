junit*.xml

# ── Eval artifacts ────────────────────────────────────────────────────
evals/reports/runs/
evals/.cache/

# ── Logs ──────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

